<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS 16+ DashBoard only indexes apps declaring a CarPlay app type. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
	<!-- iOS 26 adds a native video app declaration. Unknown keys are ignored on iOS 18. -->
	<key>com.apple.developer.carplay-video</key>
	<true/>
	<key>SBStarkCapable</key>
	<true/>
	<key>com.apple.runningboard.assertions.webkit</key>
	<true/>
	<key>com.apple.multitasking.systemappassertions</key>
	<true/>
	<key>com.apple.backboard.displaybrightness</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-manager</key>
	<true/>
</dict>
</plist>
